# -------------------------------------------------------
# SensoRAG - Environment Configuration
# -------------------------------------------------------
# Copy this file to .env and fill in your API key:
#   cp .env.example .env
#
# Get your API key at: https://console.anthropic.com/
#
# This key is optional on the server side — users can also
# enter their own key in the frontend UI. If both are set,
# the user's key takes priority.
#
# Without any key, the app still works but returns raw
# retrieval matches instead of LLM-generated answers.
# -------------------------------------------------------
ANTHROPIC_API_KEY=your-api-key-here
